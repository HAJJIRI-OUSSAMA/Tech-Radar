# Copy to .env and fill in. NEVER commit .env.

# --- LLM scoring (step 1.4) -------------------------------------------------
# NVIDIA NIM. The nvapi- key is ACCOUNT-WIDE, not per-model: switching models means
# changing LLM_MODEL only. If a call 403s, open that model's page on build.nvidia.com
# and click "Try API" to register the model family against your account.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Nemotron 3 Ultra is a REASONING model: it emits a thinking trace before the answer,
# and those tokens count against max_tokens. If digests come back mysteriously empty,
# that is the cause — raise the budget or shrink the batch.
LLM_MAX_TOKENS=16384
LLM_BATCH_SIZE=25

# Provider-specific params as raw JSON. Nemotron toggles reasoning via chat template;
# turning it OFF makes scoring much cheaper and faster if quality holds up.
# LLM_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}

# Comparison baseline — same key, cheaper and non-reasoning:
#   LLM_MODEL=meta/llama-3.3-70b-instruct
#   LLM_MAX_TOKENS=4096
#   LLM_BATCH_SIZE=30

# --- Telegram delivery (step 1.5, not wired yet) ----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Supabase (phase 2, server-side only — never in the app) ----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
